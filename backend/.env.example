# ==========================================
# Database Configuration (PostgreSQL / TypeORM)
# ==========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/sayido?schema=public
DB_SSL=false
TYPEORM_SYNC=true

# ==========================================
# Server & CORS Configuration
# ==========================================
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ==========================================
# Session & Cookie Settings
# ==========================================
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# ==========================================
# AWS S3 — File & Media Uploads
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# ==========================================
# Rate Limiting
# ==========================================
# Requests allowed per TTL window per IP
UPLOAD_RATE_TTL=60000
UPLOAD_RATE_LIMIT=3

# ==========================================
# MongoDB — Chat Messages & Realtime Data
# ==========================================
MONGODB_URI=mongodb://localhost:27017/sayido-chat

# ==========================================
# PayHere — Payment Gateway
# ==========================================
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=LKR
PAYHERE_NOTIFY_URL=http://localhost:4000/api/payhere/notify

# ==========================================
# OpenAI — Chatbot & Embeddings
# ==========================================
OPENAI_API_KEY=your_openai_api_key

# ==========================================
# Groq — AI Review Summaries & Vendor Ranking
# ==========================================
GROQ_API_KEY=your_groq_api_key
GROQ_REVIEW_SUMMARY_ENDPOINT=https://api.groq.com/openai/v1
GROQ_REVIEW_SUMMARY_MODEL=llama3-8b-8192
GROQ_RECOMMENDER_MODEL=llama3-8b-8192
GROQ_RECOMMENDER_ENDPOINT=https://api.groq.com/openai/v1

# ==========================================
# SMTP / Nodemailer (OTP & Notifications)
# Fallback: OTPs log to terminal when SMTP_PASS is blank
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Say I Do <your_email@gmail.com>"
SMTP_REPLY_TO=your_email@gmail.com
ADMIN_EMAIL=your_email@gmail.com

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
